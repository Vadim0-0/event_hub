# Данные для БД или просто ссылкой
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=event_hub
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
# DATABASE_URL=postgresql+psycopg2://auth_user:auth_password@localhost:5432/auth_db

# Данные для входа в pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=admin

# для FastAPI (на хосте)
SECRET_KEY=secret

# Тестовая БД
#TEST_DATABASE_URL=postgresql+asyncpg://user:{password}@localhost:{5432}/event_hub_test

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# SMTP
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@eventhub.local
SMTP_USE_TLS=false
SMTP_USER=
SMTP_PASSWORD=

# AI (Ollama)
AI_ENABLED=true
AI_MODEL=qwen2.5:3b
AI_TIMEOUT_SECONDS=120
# AI_BASE_URL=http://localhost:11434

# Web
WEB_APP_BASE_URL=http://localhost
DOMAIN=localhost
NUXT_PUBLIC_API_BASE=http://localhost/api

# Local Docker only (docker-compose.local.yml). Do not set on Dokploy.
NGINX_PORT=80

# CORS (comma-separated origins for FastAPI)
CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080

# Map
NUXT_PUBLIC_GEOAPIFY_API_KEY=

# Demo simulator
DEMO_SIMULATOR_ENABLED=false
DEMO_SIMULATOR_INTERVAL_MINUTES=15
DEMO_SIMULATOR_MAX_USERS=200

# Web Push (VAPID)
# Generate keys: pip install py-vapid && vapid --gen
# Public key: single base64url string → VAPID_PUBLIC_KEY
# Private key: single base64 string, no PEM headers (no -----BEGIN PRIVATE KEY-----)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@eventhub.local
PUSH_ENABLED=true
